# Copy this file to .env and adjust if your folders differ.
# Paths are relative to this repo folder (Kangaroo/kt).

# The Mac's network name + ".local" (System Settings > General > Sharing > Local hostname)
KT_HOSTNAME=my-mac.local

# The question bank (questions.json + img/) — read-only for the app
KT_CONTENT_DIR=../bank

# Where the database lives, and where nightly backups go
KT_DATA_DIR=../kt-data
KT_BACKUP_DIR=../backups
